# Bảo mật: Tuyệt đối KHÔNG đẩy file .env chứa API Keys lên GitHub
.env
.env.local
.env.*.local
!.env.example

# Thư mục đầu ra Video, Audio (giữ lại các file .sqlite trong workspace/)
workspace/*
!workspace/*.sqlite
workspace/logs/
*.log
output_audio/
assets/continuity_state/
*.mp4
*.mp3
*.wav
*.avi
*.ass
*.sqlite
!workspace/*.sqlite
*.sqlite3
*.db

# Sách đầu vào cho RAG (tránh đẩy file sách bản quyền lên repo)
*.epub
*.pdf
*.docx
books/

# Python cache & môi trường ảo
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
.idea/
.vscode/

