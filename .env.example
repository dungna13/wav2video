# =====================================================================
# CẤU HÌNH MẪU (.env.example) - SAO CHÉP THÀNH `.env` KHI CHẠY
# =====================================================================
CHECKPOINT_DB_PATH="./workspace/wav2vid_checkpoints.sqlite"
ASSETS_DIR="./assets"
CONTINUITY_STATE_DIR="./assets/continuity_state"
WORKSPACE_DIR="./workspace"
AUDIO_SAMPLE_RATE="16000"
VIDEO_FPS="30"

# Cấu hình LLM Reasoning (Tự động dùng Free LLM nếu không điền GEMINI_API_KEY)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TEMPERATURE="0.35"
GEMINI_THINKING_BUDGET="1024"
FREE_LLM_ENDPOINT="https://text.pollinations.ai/openai"
FREE_LLM_MODEL="openai-fast"

# Cấu hình 3D Storyboard Generator (9:16)
IMAGE_PROVIDER="pollinations"
POLLINATIONS_MODEL="flux"
IMAGE_WIDTH="540"
IMAGE_HEIGHT="960"
DOWNLOAD_GENERATED_IMAGE="true"

# Ngưỡng Chấm điểm Kiểm định 3 Tầng (Multi-Stage Quality Gates)
MIN_AVERAGE_SCORE="8.0"
MIN_FAITHFULNESS_SCORE="8.0"
MIN_VISUAL_TOTAL_SCORE="0.78"
MIN_OUTPUT_TOTAL_SCORE="0.80"
TIKTOK_ACCESS_TOKEN=""

# (Tuỳ chọn) Key Pexels (https://www.pexels.com/api/) để dùng video stock thật cho từng cảnh
PEXELS_API_KEY=""

# (Tuỳ chọn) Key Pixabay (https://pixabay.com/api/docs/) để dùng video stock thật thay thế khi chưa có Pexels
PIXABAY_API_KEY=""

